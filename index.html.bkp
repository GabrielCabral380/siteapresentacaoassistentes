  <meta name="description" content="Xavier, Maya e Gabriel: uma equipe unificada de assistentes de IA que compartilham o mesmo conjunto de capacidades — automação, agenda, WhatsApp, casa conectada, visão computacional e criação de software.">
  <meta name="theme-color" content="#07080f">
  <title>Assistentes IA | Xavier, Maya e Gabriel — uma equipe, as mesmas capacidades</title>
  <!-- Sem cache do HTML: ao recarregar, o navegador pega sempre a versão nova (e os ?v= abaixo) -->
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  <!-- ?v= força o navegador a baixar a versão nova após cada alteração -->
  <link rel="stylesheet" href="css/style.css?v=20261025-3">
  <style id="avatar-upgrade">
    /* Retratos SVG: mais humanos, legíveis e leves que os antigos robôs geométricos. */
    .avatar-svg .av-fundo { fill: url(#av-bg-xavier); stroke-width: 1.5; }
    .avatar-svg .av-cabeca { fill: var(--av-pele, #d79b7b); stroke: none; }
    .avatar-svg .av-tela { fill: none; stroke: rgba(255,255,255,.12); stroke-width: 1; }
    .avatar-svg .av-corpo { fill: var(--av-roupa, #17243c); stroke: rgba(255,255,255,.12); stroke-width: 1; }
    .avatar-svg .av-cabelo { fill: var(--av-cabelo, #2b1b18); }
    .avatar-svg .av-orelha { fill: var(--av-pele, #d79b7b); stroke: rgba(255,255,255,.18); stroke-width: 1; }
    .avatar-svg .av-olho { fill: #f7fbff; stroke: rgba(255,255,255,.35); stroke-width: 1; }
    .avatar-svg .av-pupila { fill: var(--cor-tema-2); filter: drop-shadow(0 0 3px var(--cor-tema-2)); }
    .avatar-svg .av-sobrancelha { fill: none; stroke: var(--av-cabelo, #2b1b18); stroke-width: 2.2; stroke-linecap: round; }
    .avatar-svg .av-nariz { fill: none; stroke: color-mix(in srgb, var(--av-pele, #d79b7b) 55%, #43251f); stroke-width: 1.4; stroke-linecap: round; }
    .avatar-svg .av-boca { fill: none; stroke: #ffb6bd; stroke-width: 2.2; stroke-linecap: round; transform: scaleX(calc(.72 + var(--boca, 0) * .5)); }
    .avatar-svg .av-brilho { fill: var(--cor-tema-2); filter: drop-shadow(0 0 5px var(--cor-tema-2)); }
    .avatar-svg .av-traco { stroke: var(--cor-tema); }
    .avatar-svg .av-peca { fill: var(--cor-tema); opacity: .8; }
    .avatar-svg .av-pensando { fill: var(--cor-tema-2); }
    .avatar-svg .av-marca { fill: none; stroke: rgba(255,255,255,.32); stroke-width: 1; }
    .avatar-svg .av-olhos { transform-box: fill-box; transform-origin: center; }
    .demo-palco[data-estado="falando"] .avatar-svg .av-boca { stroke-width: 3; }
    .demo-palco[data-estado="ouvindo"] .avatar-svg .av-brilho { animation: avatarListen 1s ease-in-out infinite; }
    @keyframes avatarListen { 50% { opacity: .35; transform: scale(1.5); } }
    .demo-escolha[data-assistente="xavier"] .avatar-svg { --av-pele:#d69b7e; --av-cabelo:#4b2d27; --av-roupa:#17243c; }
    .demo-escolha[data-assistente="maya"] .avatar-svg { --av-pele:#dba483; --av-cabelo:#201a27; --av-roupa:#241b3f; }
    .demo-escolha[data-assistente="gabriel"] .avatar-svg { --av-pele:#a96f50; --av-cabelo:#17131a; --av-roupa:#193b46; }
    .demo-escolha[data-assistente="xavier"] .av-fundo, .demo-palco .avatar-svg .av-fundo { fill: url(#av-bg-xavier); }
    .demo-escolha[data-assistente="maya"] .av-fundo { fill: url(#av-bg-maya); }
    .demo-escolha[data-assistente="gabriel"] .av-fundo { fill: url(#av-bg-gabriel); }
  </style>
  <!-- Foto principal (maior elemento da primeira tela): baixa cedo, já no tamanho certo -->
  <link rel="preload" as="image" type="image/avif" fetchpriority="high"
        imagesrcset="img/otimizadas/familia-240.avif 240w, img/otimizadas/familia-480.avif 480w, img/otimizadas/familia-960.avif 960w, img/otimizadas/familia-1440.avif 1440w"
        imagesizes="(max-width: 1000px) 100vw, 960px">
  <script>
    /* <picture> com AVIF/WebP (img/otimizadas, gerado por tools/otimizar_imagens.py): se a versão leve falhar,
       remove os <source> e o navegador volta ao PNG do src; só depois cai no SVG. */
    function soltarFontes(img) {
      var fontes = img.parentNode && img.parentNode.tagName === "PICTURE" ? img.parentNode.querySelectorAll("source") : [];
      for (var i = 0; i < fontes.length; i++) fontes[i].remove();
      return fontes.length > 0;
    }
  </script>
  <script src="js/main.js?v=20261025-3" defer></script>
  <!-- Avatares 3D: avatares3d.js é pequeno; o Three.js (js/vendor/three.min.js, ~170 KB comprimido)
       só é baixado sob demanda, quando um avatar se aproxima da tela ou o navegador fica ocioso. -->
  <script src="js/avatares3d.js?v=20261025-3" defer></script>
</head>
